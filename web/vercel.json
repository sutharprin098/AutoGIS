{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/AutoGIS.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"AutoGIS.zip\"" }
      ]
    },
    {
      "source": "/plugins.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
