{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/AutoGIS.zip",
      "destination": "https://github.com/sutharprin098/AutoGIS/releases/latest/download/AutoGIS.zip",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/plugins.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
